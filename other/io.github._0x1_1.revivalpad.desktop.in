[Desktop Entry]
Name=@REVIVALPAD_DISPLAY_NAME@
GenericName=@REVIVALPAD_SHORT_DESCRIPTION@
Comment=@REVIVALPAD_DESCRIPTION@
Exec=@REVIVALPAD_EXECUTABLE_NAME@ --show %f
Icon=@REVIVALPAD_APP_ID@
StartupNotify=true
StartupWMClass=@REVIVALPAD_EXECUTABLE_NAME@
Terminal=false
Type=Application
Categories=Game;Qt;Utility;
MimeType=application/x-amgp;
Keywords=game;gamepad;controller;keyboard;joystick;mouse;
Actions=run-in-tray;

[Desktop Action run-in-tray]
Name=Open in system tray only
Exec=@REVIVALPAD_EXECUTABLE_NAME@ --tray
